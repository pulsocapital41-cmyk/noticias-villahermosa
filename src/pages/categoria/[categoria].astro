---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';

export async function getStaticPaths() {
  const categories = [
    { slug: 'local', label: 'Local', desc: 'Pulso ciudadano de Villahermosa: servicios públicos, vialidades, colonias y comunidad.' },
    { slug: 'seguridad', label: 'Seguridad', desc: 'Reportes policiacos, vialidad, operativos de seguridad y protección ciudadana en Tabasco.' },
    { slug: 'politica', label: 'Política', desc: 'Cobertura institucional, gobierno estatal, ayuntamientos, partidos y decisiones públicas.' },
    { slug: 'economia', label: 'Economía', desc: 'Comercio, inversiones, empleo, programas sociales y pulso financiero de Tabasco.' },
    { slug: 'deportes', label: 'Deportes', desc: 'Olmecas de Tabasco, beisbol, futbol, competencias locales y atletas del estado.' },
    { slug: 'opinion', label: 'Opinión', desc: 'Columnas, análisis crítico y puntos de vista sobre la realidad tabasqueña y nacional.' },
  ];

  const allNoticias = await getCollection('noticias');

  return categories.map((cat) => {
    const filtered = allNoticias
      .filter((n) => n.data.category === cat.label)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { categoria: cat.slug },
      props: {
        categoryLabel: cat.label,
        categoryDesc: cat.desc,
        articles: filtered,
      },
    };
  });
}

const { categoryLabel, categoryDesc, articles } = Astro.props;
---

<BaseLayout
  title={`${categoryLabel} | Noticias Villahermosa`}
  description={categoryDesc}
  currentCategory={categoryLabel}
>
  <div class="container-editorial category-page">
    <header class="category-banner">
      <span class="badge-category">{categoryLabel}</span>
      <h1 class="category-main-title">{categoryLabel}</h1>
      <p class="category-description">{categoryDesc}</p>
    </header>

    {articles.length === 0 ? (
      <div class="empty-state">
        <p>Aún no hay notas publicadas en esta sección.</p>
      </div>
    ) : (
      <div class="category-articles-grid">
        {articles.map((article, index) => (
          <NewsCard article={article} variant="default" isLcp={index === 0} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .category-page {
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .category-banner {
    border-top: 4px solid var(--color-qroo-navy);
    border-bottom: 1px solid var(--color-qroo-border);
    padding: 1.5rem 0;
    margin-bottom: 2.25rem;
    position: relative;
  }

  .category-banner::before {
    content: "";
    position: absolute;
    top: -4px;
    left: 0;
    width: 90px;
    height: 4px;
    background-color: var(--color-qroo-cyan);
  }

  .category-main-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--color-qroo-navy);
    margin: 0.25rem 0 0.5rem 0;
    line-height: 1.1;
  }

  .category-description {
    font-size: 1.05rem;
    color: var(--color-qroo-slate);
    margin: 0;
    max-width: 65ch;
  }

  .category-articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .category-articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .category-articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    background-color: var(--color-qroo-mist);
    padding: 3rem 1.5rem;
    text-align: center;
    border-radius: var(--radius-md);
  }
</style>
