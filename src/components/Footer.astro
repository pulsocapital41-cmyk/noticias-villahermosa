---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-editorial footer-grid">
    <div class="footer-brand-col">
      <a href="/" class="footer-logo-link">
        <img
          src="/logo.png"
          alt="Noticias Villahermosa"
          class="footer-logo-img"
          width="600"
          height="145"
          loading="lazy"
        />
      </a>
      <p class="footer-mission">
        Las noticias más importantes de la capital tabasqueña y la región. Cobertura oportuna en seguridad, política, economía, vida local, deportes y opinión.
      </p>
      <p class="footer-contact-note">
        <strong>Villahermosa, Tabasco · Edición Digital</strong><br />
        Portal oficial: noticiasvhsa.com
      </p>
      <div class="footer-cloudinary-badge">
        <span>Infraestructura Global</span>
        <strong>Cloudflare CDN</strong>
      </div>
    </div>

    <div class="footer-links-col">
      <h4 class="footer-col-title">Secciones</h4>
      <ul class="footer-nav-list">
        <li><a href="/">Portada</a></li>
        <li><a href="/categoria/local">Local</a></li>
        <li><a href="/categoria/seguridad">Seguridad</a></li>
        <li><a href="/categoria/politica">Política</a></li>
        <li><a href="/categoria/economia">Economía</a></li>
        <li><a href="/categoria/deportes">Deportes</a></li>
        <li><a href="/categoria/opinion">Opinión</a></li>
        <li>
          <a href="https://central.neuronamedios.com" target="_blank" rel="noopener noreferrer">
            Central Editorial →
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container-editorial footer-bottom-inner">
      <p>© {currentYear} <strong>Noticias Villahermosa</strong> (noticiasvhsa.com). Todos los derechos reservados.</p>
      <p class="footer-tech">Arquitectura Editorial de Ultra-Velocidad · Mobile-First</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-qroo-navy);
    color: #cbd5e1;
    margin-top: 4rem;
    border-top: 4px solid var(--color-qroo-cyan);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    background-color: #ffffff;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    margin-bottom: 1rem;
  }

  .footer-logo-img {
    height: 44px;
    width: auto;
  }

  .footer-mission {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #94a3b8;
    max-width: 44ch;
    margin: 0 0 0.75rem 0;
  }

  .footer-contact-note {
    margin: 0 0 1rem 0;
    font-size: 0.84rem;
    color: #94a3b8;
    line-height: 1.5;
  }

  .footer-contact-note strong {
    color: #ffffff;
  }

  .footer-cloudinary-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    background: rgba(206, 44, 157, 0.14);
    border: 1px solid rgba(206, 44, 157, 0.38);
    color: #e2e8f0;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
  }

  .footer-cloudinary-badge strong {
    color: #f5d0fe;
  }

  .footer-col-title {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ffffff;
    margin: 0 0 1rem 0;
    border-left: 3px solid var(--color-qroo-cyan);
    padding-left: 0.6rem;
  }

  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.55rem;
    font-size: 0.9rem;
  }

  .footer-nav-list a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-nav-list a:hover {
    color: var(--color-qroo-cyan);
  }

  .footer-bottom {
    background-color: var(--color-qroo-navy-dark);
    padding: 1.15rem 0;
    font-size: 0.78rem;
    color: #64748b;
  }

  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    justify-content: space-between;
  }

  @media (min-width: 640px) {
    .footer-bottom-inner {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom strong {
    color: #cbd5e1;
  }
</style>
